{
    "version": "0.2.0",
    "configurations": [
        // ============================================
        // 1. Run Flask App (Development Mode)
        // ============================================
        {
            "name": "Python: Flask App",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.main:app",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload",
                "--port",
                "5000"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        // ============================================
        // 2. Run Flask App (Alternative: Direct Module)
        // ============================================
        {
            "name": "Python: Run app.main",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app/main.py",
            "args": [],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        // ============================================
        // 3. Run Tests with Debugging
        // ============================================
        {
            "name": "Python: Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "--no-cov",
                "${file}"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        // ============================================
        // 4. Run Single Test File
        // ============================================
        {
            "name": "Python: Debug Current Test File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "--no-cov",
                "${file}"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        // ============================================
        // 5. Attach to Running Process (Advanced)
        // ============================================
        {
            "name": "Python: Attach to Flask",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": true
        },
        // ============================================
        // 6. Run Any Python Script
        // ============================================
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ],
    // ============================================
    // 7. Compound Configurations (Run Multiple)
    // ============================================
    "compounds": [
        {
            "name": "Flask + Tests",
            "configurations": [
                "Python: Flask App",
                "Python: Debug Tests"
            ],
            "preLaunchTask": null
        }
    ]
}
